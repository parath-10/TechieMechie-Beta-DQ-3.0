# Local runs: copy to ".env". On Railway: add each line under the service's Variables tab instead.

# Supabase (Project Settings -> API). The service_role / secret key stays on the server ONLY.
SUPABASE_URL=https://hqsylnbxepmikislkxjy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_publishable_iiNxEqto5RasQnjC5WoniQ_GLRq2EmN

# Encrypts saved platform tokens. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: if it changes, saved connections can no longer be read (just reconnect them).
NEXUS_SECRET_KEY=

# Gemini key for the AI features: https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6LRHnNnXqGmQN6gKwDwTQnFUgkt6vkfPM0lrbFD_sM91g
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional settings
# Times shown in the dashboard (Railway runs on UTC)
APP_TIMEZONE=Asia/Kolkata
# 60 = 1 real minute is 1 hour of simulated orders
ORDER_SIM_SPEED=60
# 1 = "Test connection" calls the real Facebook/Instagram/YouTube/Shopify APIs
LIVE_PLATFORM_APIS=0
# 0 = start with an empty database instead of sample products
SEED_SAMPLE_DATA=1
# Supabase Free plan file limit is 50 MB; on Pro you may raise it to 100
MAX_VIDEO_MB=50
